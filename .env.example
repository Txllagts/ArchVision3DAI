# ---------------------------------------------------------------------------
# ArchVision 3D AI - variables de entorno
# Copiar a .env y ajustar. Nunca commitear .env.
# ---------------------------------------------------------------------------

# Entorno: development | staging | production
NODE_ENV=development

# --- Base de datos ---------------------------------------------------------
# Desarrollo (SQLite, cero configuracion):
DATABASE_URL="file:./dev.db"
# Staging / produccion (PostgreSQL): cambiar tambien `provider` en
# packages/database/prisma/schema.prisma a "postgresql".
# DATABASE_URL="postgresql://user:password@localhost:5432/archvision?schema=public"

# --- Autenticacion ---------------------------------------------------------
# Secreto usado para firmar/derivar tokens. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="cambiar-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres"
SESSION_TTL_DAYS=30

# --- Aplicacion ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# El nombre comercial vive en packages/config; esto solo permite override.
NEXT_PUBLIC_APP_NAME="ArchVision 3D AI"

# --- Almacenamiento de archivos (Fase 5+) ----------------------------------
# driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./storage"
# S3_ENDPOINT=""
# S3_REGION="us-east-1"
# S3_BUCKET="archvision"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Facturacion (Fase 7) --------------------------------------------------
# manual: simula los cobros; solo funciona fuera de produccion.
# wompi:  cobra de verdad en pesos colombianos (tarjeta, PSE, Nequi).
BILLING_PROVIDER=manual

# Credenciales de Wompi. sandbox para pruebas, production para cobrar.
WOMPI_ENVIRONMENT=sandbox
# WOMPI_PUBLIC_KEY="pub_test_..."
# WOMPI_PRIVATE_KEY="prv_test_..."
# Firma el importe del checkout para que nadie lo altere en la URL.
# WOMPI_INTEGRITY_SECRET=""
# Verifica los eventos que Wompi envia al webhook.
# WOMPI_EVENTS_SECRET=""

# Secreto que autoriza el cobro de renovaciones desde el programador de tareas.
# Minimo 16 caracteres. Sin el, la ruta /api/billing/renewals no responde.
# BILLING_CRON_SECRET=""

# --- Asistente (Fase 6) ----------------------------------------------------
# local: todo se resuelve con reglas dentro del proceso, sin clave ni conexion.
# claude: las peticiones que las reglas no reconocen van al modelo de lenguaje.
# Sin ANTHROPIC_API_KEY, "claude" degrada a "local" en vez de fallar.
ASSISTANT_PROVIDER=local
# ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-opus-5"

# --- Servicio de vision (Fase 7) -------------------------------------------
AI_SERVICE_URL="http://127.0.0.1:8000"
# Debe coincidir con AI_SERVICE_API_KEY en apps/ai-service/.env.
AI_SERVICE_TOKEN=""
# Modo simulado mientras no existan modelos reales
AI_MODE=mock

# --- Colas / Redis (Fase 6) ------------------------------------------------
# REDIS_URL="redis://localhost:6379"
