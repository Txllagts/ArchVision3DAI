# =============================================================================
# ArchVision 3D AI - Configuración de Variables de Entorno
# Copiar este archivo a .env y ajustar las credenciales reales.
# NUNCA commitear el archivo .env al repositorio de Git.
# =============================================================================

# =============================================================================
# 1. CREDENCIALES Y VARIABLES PARA EL FRONTEND (CLIENTE - NEXT_PUBLIC_*)
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ArchVision 3D AI"

# --- Supabase Cliente (Público) ---------------------------------------------
# Obtener en Supabase Console -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."


# =============================================================================
# 2. CREDENCIALES Y VARIABLES PARA EL BACKEND (SERVIDOR / PRISMA / SUPABASE)
# =============================================================================

# Entorno: development | staging | production
NODE_ENV=development

# --- Conexión a Base de Datos Supabase (PostgreSQL) ---------------------------
# Obtener en Supabase Console -> Project Settings -> Database -> Connection string
# 1. DATABASE_URL: URL con Transaction Pooler (puerto 6543) para consultas de la app
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2. DIRECT_URL: URL directa a PostgreSQL (puerto 5432) necesaria para migraciones de Prisma
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase Servidor (Privado / Admin) -------------------------------------
# Clave con permisos completos de administrador (NUNCA exponer en el Frontend)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- Autenticación -----------------------------------------------------------
# Secreto usado para firmar y derivar tokens de sesión.
# Generar en terminal con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="cambiar-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres"
SESSION_TTL_DAYS=30

# --- Almacenamiento de Archivos ----------------------------------------------
# driver: local | s3 | supabase
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./storage"
# S3_ENDPOINT=""
# S3_REGION="us-east-1"
# S3_BUCKET="archvision"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Facturación (Wompi) ------------------------------------------------------
BILLING_PROVIDER=manual
WOMPI_ENVIRONMENT=sandbox
# WOMPI_PUBLIC_KEY="pub_test_..."
# WOMPI_PRIVATE_KEY="prv_test_..."
# WOMPI_INTEGRITY_SECRET=""
# WOMPI_EVENTS_SECRET=""
# BILLING_CRON_SECRET=""

# --- Asistente AI -------------------------------------------------------------
ASSISTANT_PROVIDER=local
# ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-opus-5"

# --- Servicio de Visión / IA -------------------------------------------------
AI_SERVICE_URL="http://localhost:8001"
AI_SERVICE_TOKEN=""
AI_MODE=local

# --- Colas / Redis -----------------------------------------------------------
# REDIS_URL="redis://localhost:6379"
