APP_NAME="ArchVision AI Service"
DEBUG=true
HOST="127.0.0.1"
PORT=8000
DEVICE="cuda"
AI_MODE="local"
# Debe coincidir exactamente con AI_SERVICE_TOKEN del .env de la raiz.
AI_SERVICE_API_KEY=""
RMBG_MODEL_PATH=models/rmbg-1.4.onnx
# Si el ONNX falta o es invalido (p. ej. un .pth renombrado), el servicio lo
# pone en cuarentena (*.invalid-checkpoint) y descarga el oficial de HF.
REMBG_AUTO_DOWNLOAD=true
REMBG_MODEL_REPO=briaai/RMBG-1.4
REMBG_MODEL_REPO_FILE=onnx/model.onnx
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
